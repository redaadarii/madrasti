# Copier en .env puis adapter. Ne jamais commiter le fichier .env.
MADRASTI_DB_PASSWORD=change-me
# 32 caractères minimum : openssl rand -base64 48
MADRASTI_JWT_SECRET=
MADRASTI_PUBLIC_URL=https://ecole.example.ma
MADRASTI_HTTP_PORT=8081
# true derrière HTTPS (obligatoire en production) ; false uniquement pour un test en HTTP hors localhost
MADRASTI_COOKIE_SECURE=true
# true pour charger les données de démonstration au premier démarrage
MADRASTI_SEED=false
MADRASTI_BACKEND_REPLICAS=2
# Tentatives de connexion par minute et par IP (protection contre le force brute)
MADRASTI_LOGIN_PER_MINUTE=10
# SMS : log (aucun envoi) ou twilio
MADRASTI_SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Traduction automatique des contenus (vide = désactivée)
ANTHROPIC_API_KEY=
MADRASTI_JITSI_URL=https://meet.jit.si
# Paiement en ligne : simulated (démonstration, aucun argent ne circule), stripe (Stripe Checkout) ou cmi (CMI)
MADRASTI_PAYMENTS_PROVIDER=simulated
MADRASTI_PAYMENTS_CURRENCY=mad
# Clé secrète Stripe (sk_live_… ou sk_test_…), requise avec MADRASTI_PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
# CMI (3D Pay Hosting) : identifiants fournis par le CMI ; URL de test par défaut
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
MADRASTI_PAYMENT_FORM_ORIGINS=https://testpayment.cmi.co.ma https://payment.cmi.co.ma
